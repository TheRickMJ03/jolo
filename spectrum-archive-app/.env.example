# Copy to .env and fill in what you need. Every line is optional: with nothing
# set, the app runs terminal-only, echoes, and archives to local Parquet.

# ---- Spectrum Cloud (Photon dashboard → project Settings) -------------------
# Needed for iMessage, and for Telegram (its inbound runs through Fusor).
PROJECT_ID=
PROJECT_SECRET=

# ---- Telegram (bot token from @BotFather) — needs the project creds too ------
TELEGRAM_BOT_TOKEN=

# ---- WhatsApp Business (Meta for Developers) — all three, no project needed --
WA_TOKEN=
WA_NUMBER_ID=
WA_SECRET=

# The SDK's own names are accepted too, and win if both are set:
# SPECTRUM_TELEGRAM_BOT_TOKEN=
# SPECTRUM_WHATSAPP_BUSINESS_ACCESS_TOKEN=
# SPECTRUM_WHATSAPP_BUSINESS_PHONE_NUMBER_ID=
# SPECTRUM_WHATSAPP_BUSINESS_APP_SECRET=

# ---- Webhook server — blank port leaves it (and the query API) off -----------
WEBHOOK_PORT=
WEBHOOK_PATH=/spectrum/webhook
# From the Photon dashboard. Without it, signed deliveries fail.
SPECTRUM_WEBHOOK_SECRET=
# Any string you choose; must match what you enter in the Meta dashboard.
WA_VERIFY_TOKEN=

# ---- LLM, as OpenAI-compatible chat completions ------------------------------
# Blank LLM_MODEL keeps the app echoing. `npm run models` lists what your key
# can reach.
LLM_MODEL=
# Default: http://localhost:11434/v1 (Ollama)
LLM_BASE_URL=
LLM_API_KEY=
LLM_TIMEOUT_MS=120000
LLM_HISTORY_TURNS=12
LLM_MAX_STEPS=5
# Default asks for short plain-text replies.
LLM_SYSTEM_PROMPT=
#
# Google AI Studio (free tier):  LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# Groq:                          LLM_BASE_URL=https://api.groq.com/openai/v1
# OpenRouter (:free models):     LLM_BASE_URL=https://openrouter.ai/api/v1
# Ollama:                        LLM_BASE_URL=http://localhost:11434/v1

# ---- JOLO agent (Bhavesh's): onboarding + the menu flow ----------------------
# POST {AGENT_URL}/v1/turn; the contract is in ../docs/contracts.md.
# Blank AGENT_URL leaves onboarding and the menu flow off: replies use LLM_MODEL
# or echo, as above. To try the flow before the real agent exists, run
# `npm run agent:stub` and set AGENT_URL=http://127.0.0.1:8788
AGENT_URL=
# Sent as "Authorization: Bearer …" when set.
AGENT_TOKEN=
# One photo takes 15 to 100 seconds to read, and an owner can send several.
AGENT_TIMEOUT_MS=300000

# ---- Memory (transcripts + notes) — "off" keeps everything in memory only ----
MEMORY_FILE=data/memory.json

# ---- Archive -----------------------------------------------------------------
# Blank S3_BUCKET → local Parquet in ARCHIVE_DIR.
# ARCHIVE_DIR=off → archive disabled entirely (even if S3_BUCKET is set).
S3_BUCKET=
S3_PREFIX=spectrum-archive
AWS_REGION=us-east-1
# Use the scoped app credentials (iam-policy.json) here. Leave blank to use the
# AWS default chain instead (AWS_PROFILE, SSO, instance role).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Only for temporary (STS) credentials.
# AWS_SESSION_TOKEN=
ARCHIVE_DIR=data/archive
# Crash-safety journal: every row lands here before archive() returns.
ARCHIVE_SPOOL_DIR=data/spool
ARCHIVE_FLUSH_INTERVAL_MS=30000
ARCHIVE_FLUSH_MAX_ROWS=500
# Used by `npm run archive:setup` for the S3 lifecycle rule.
ARCHIVE_EXPIRE_DAYS=14

# ---- Query/send API — blank API_KEY → /api routes off (webhook still works) --
# Generate one with: openssl rand -hex 32
API_KEY=
