{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListOnlyTheArchivePrefix",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::YOUR_BUCKET",
      "Condition": {
        "StringLike": {
          "s3:prefix": ["spectrum-archive", "spectrum-archive/*"]
        }
      }
    },
    {
      "Sid": "ReadWriteOnlyTheArchivePrefix",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:GetObject", "s3:DeleteObject"],
      "Resource": "arn:aws:s3:::YOUR_BUCKET/spectrum-archive/*"
    }
  ]
}
