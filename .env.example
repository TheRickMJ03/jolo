# Copy to .env in the repo root (never commit .env). Used by docker compose and the scripts.

# Required. The bridge sends it as "Authorization: Bearer <AGENT_TOKEN>".
# Make one: python -c "import secrets; print(secrets.token_urlsafe(32))"
AGENT_TOKEN=

# Salt for stored phone hashes. Set once and never change it.
JOLO_PHONE_SALT=

# First start only: make a phone the owner of a café (comma list): +16095550100=small_world_coffee
JOLO_OWNERS=

# Where the Qwen model server is. Default (leave unset) = the SSH tunnel on your computer's port 8000.
# JOLO_MODEL_ENDPOINT=http://host.docker.internal:8000/v1

# Only with docker-compose.firestore.yml: full path of the service-account key on this computer.
# FIREBASE_KEY_FILE=
