{
  "name": "jolo-owner-app",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:rules": "firebase emulators:exec --only firestore --project demo-jolo \"jest -c jest.rules.config.js\"",
    "emulators": "firebase emulators:start --only auth,firestore --project demo-jolo",
    "seed:emulator": "node scripts/seed-emulator.mjs",
    "seed:cafes": "node scripts/seed-cafes.mjs",
    "link-owner": "node scripts/link-owner.mjs"
  },
  "dependencies": {
    "@expo-google-fonts/montserrat": "0.4.2",
    "@expo-google-fonts/plus-jakarta-sans": "0.4.2",
    "@expo/vector-icons": "15.1.1",
    "@gorhom/bottom-sheet": "5.2.14",
    "@react-native-firebase/app": "27.1.0",
    "@react-native-firebase/auth": "27.1.0",
    "@react-native-firebase/firestore": "27.1.0",
    "expo": "54.0.38",
    "expo-asset": "12.0.14",
    "expo-blur": "15.0.8",
    "expo-build-properties": "1.0.10",
    "expo-constants": "18.0.14",
    "expo-dev-client": "6.0.21",
    "expo-font": "14.0.12",
    "expo-linking": "8.0.12",
    "expo-location": "19.0.8",
    "expo-router": "6.0.24",
    "expo-splash-screen": "31.0.13",
    "expo-status-bar": "3.0.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "2.28.0",
    "react-native-maps": "1.20.1",
    "react-native-reanimated": "4.1.7",
    "react-native-safe-area-context": "5.6.2",
    "react-native-screens": "4.16.0",
    "react-native-worklets": "0.5.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.2",
    "@testing-library/react-native": "14.1.0",
    "@types/react": "19.1.17",
    "eslint": "9.39.5",
    "eslint-config-expo": "10.0.0",
    "eslint-config-prettier": "10.1.8",
    "firebase": "12.11.0",
    "firebase-admin": "14.4.0",
    "firebase-tools": "15.34.1",
    "globals": "16.5.0",
    "jest": "29.7.0",
    "jest-expo": "54.0.18",
    "prettier": "3.9.10",
    "typescript": "5.9.3"
  },
  "jest": {
    "preset": "jest-expo",
    "modulePathIgnorePatterns": [
      "<rootDir>/ios/",
      "<rootDir>/android/"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "<rootDir>/tests/rules/"
    ],
    "setupFiles": [
      "<rootDir>/jest.setup.js"
    ]
  }
}
