# Copy to .env in the repo root on the host (never commit .env; it is in .gitignore).

# The bridge sends this as "Authorization: Bearer ..." (the same value as AGENT_TOKEN in the bridge's .env).
# Required when agent.api.host is 0.0.0.0. Make it long and random: python -c "import secrets; print(secrets.token_urlsafe(32))"
AGENT_TOKEN=

# Optional second secret for other callers (X-Jolo-Key header).
JOLO_API_KEY=

# Salt for the stored phone hashes. Set once, keep forever: changing it makes every stored hash unfindable.
JOLO_PHONE_SALT=

# Firestore: the service-account key for project jolo-ec76d (a file path on this host, never in Git),
# and agent.store.backend: firestore in config.yaml.
GOOGLE_APPLICATION_CREDENTIALS=
